{
  "opencollection": "1.0.0",
  "info": {
    "name": "Saasment Alerts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Security Alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.saasment.com/v1/alerts",
            "params": [
              {
                "name": "severity",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns security alerts generated by Saasment posture monitoring."
        }
      ]
    }
  ],
  "bundled": true
}