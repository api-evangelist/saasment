{
  "opencollection": "1.0.0",
  "info": {
    "name": "Saasment Alerts Integrations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.saasment.com/v1/integrations"
          },
          "docs": "Returns configured SaaS application integrations."
        },
        {
          "info": {
            "name": "Create Integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.saasment.com/v1/integrations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Connects a new SaaS application to Saasment for monitoring."
        },
        {
          "info": {
            "name": "Delete Integration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.saasment.com/v1/integrations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Removes a SaaS application integration from Saasment monitoring."
        }
      ]
    }
  ],
  "bundled": true
}